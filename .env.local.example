# ── OpenAI API Key ──────────────────────────────────────────────────────
# This file is a template. Copy it to .env.local and add your real key:
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored and never committed to version control.
#
# Without a key, the app runs in MOCK_MODE (hardcoded demo data) so you
# can present immediately. With a key, all LLM calls hit the real API.
#
# Get a key at: https://platform.openai.com/api-keys

OPENAI_API_KEY=
